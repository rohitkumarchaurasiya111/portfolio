# Copy this file to .env.local for local dev values, and set the real values as
# Environment Variables in your Vercel project for production. Never commit .env.local.

# ---------------------------------------------------------------------------
# Contact form — built-in serverless handler (api/contact.ts)
# ---------------------------------------------------------------------------
# These three are server-only (no VITE_ prefix) and are never exposed to the browser bundle.

# Required. Get one at https://resend.com — free tier is enough for a portfolio's traffic.
RESEND_API_KEY=

# Required. The inbox that should receive contact-form submissions.
CONTACT_TO_EMAIL=

# Optional. Must be an address on a domain you've verified with Resend. Until you verify a
# domain, Resend's shared sandbox address (the default below) only delivers to the email
# you signed up to Resend with — fine for testing, not for real visitors.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Contact form — optional override
# ---------------------------------------------------------------------------
# By default the form POSTs to the built-in /api/contact function above. Set this
# (client-exposed, hence the VITE_ prefix) only if you want to point the form at a
# different backend instead — e.g. Formspree or Getform.
VITE_CONTACT_ENDPOINT=
